{
  "name": "BLT Benchmark Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "remoteEnv": {
    "BLT_DATABASE_PATH": "${containerWorkspaceFolder}/var/app.db",
    "BLT_DATA_DIR": "${containerWorkspaceFolder}/var/data",
    "BLT_GROUND_TRUTH_PATH": "${containerWorkspaceFolder}/groundtruth/official_tum.txt",
    "BLT_STATIC_DIR": "${containerWorkspaceFolder}/dist",
    "BLT_ADMIN_TOKEN": "change-me-dev"
  },
  "forwardPorts": [5173, 8017, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Vite frontend",
      "onAutoForward": "notify"
    },
    "8017": {
      "label": "FastAPI development",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "FastAPI production-like",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "python -m pip install --user -r requirements-dev.txt && npm ci && mkdir -p var/data groundtruth",
  "postStartCommand": "bash .devcontainer/start-dev.sh",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pytest",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
